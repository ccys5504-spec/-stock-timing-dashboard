# 이 파일은 예시일 뿐이며 git에 커밋됩니다(민감정보 없음).
# 실제 값은 이 파일을 "secrets.toml"로 복사해서 채워 넣으세요 —
# secrets.toml은 .gitignore에 있어서 git에 올라가지 않습니다.
#
# GITHUB_TOKEN: https://github.com/settings/tokens 에서 "gist" 권한만 체크한
# 개인용 토큰(Personal Access Token)을 발급받아 넣으세요.
# GIST_ID: 관심종목/보유종목을 저장할 비공개 Gist의 ID.
#          (data/fetch.py 관련 설명 참고 — 없으면 로컬 JSON 파일로 동작합니다.)
#
# Streamlit Cloud에 배포한 앱에서도 똑같이 쓰려면, 앱 관리 화면의
# Settings → Secrets에 아래 두 줄을 그대로 붙여넣으세요.

GITHUB_TOKEN = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GIST_ID = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
